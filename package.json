{
  "name": "crystalball-web",
  "version": "1.0.0",
  "description": "Crystal Ball-style Monte Carlo simulation add-in for Excel on the web, in TypeScript.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "start": "webpack serve --mode development",
    "dashboard": "webpack serve --mode development --env http --port 3100",
    "examples": "tools/copy-cb-examples.sh",
    "dev-certs": "office-addin-dev-certs install",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hyperformula": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/office-js": "^1.0.377",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "office-addin-dev-certs": "^1.13.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  }
}
